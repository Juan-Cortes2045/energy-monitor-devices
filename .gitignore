# ── Secrets: never commit ──────────────────────────────────────────────────────
# Per-device identity, api key, broker address and setup-portal password.
# Copy esp32-pzem-monitor/secrets.h.example to secrets.h instead.
esp32-pzem-monitor/secrets.h

# Development CA embedded in the firmware, generated by docker/mosquitto/generate-dev-certs.sh
esp32-pzem-monitor/dev_ca.h

# TLS material (development CA, broker certificate and private keys, Let's Encrypt copies)
*.pem
*.key
*.crt
*.csr
*.srl
docker/mosquitto/certs/*
!docker/mosquitto/certs/.gitignore

# VAPID key pairs, if generated in this folder
vapid*

# Environment files: only the .example templates are versioned
.env
.env.*
!*.example

# ── Build output and editors ───────────────────────────────────────────────────
build/
*.bin
*.elf
*.hex
*.map
.vscode/
.idea/
.DS_Store
