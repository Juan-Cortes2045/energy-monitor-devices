# Copy to .env.prod on the server (ignored by git) and fill in every value.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Backend source ──────────────────────────────────────────────────────────────
# Path to a clone of energy-monitor-backend, relative to this folder.
BACKEND_CONTEXT=../../backend/energy-monitor-backend

# ── Database ────────────────────────────────────────────────────────────────────
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Backend security ────────────────────────────────────────────────────────────
# openssl rand -hex 32
SECURITY_RESET_PEPPER=
# Public origin of the web app, e.g. https://app.example.com
SECURITY_CORS_ALLOWED_ORIGINS=
# Folder with private.pem and public.pem (RSA pair for the JWTs)
JWT_KEYS_DIR=/opt/energy-monitor/keys
# User the backend container runs as; it must be able to read private.pem. The image
# uses 10001: put the uid/gid owning JWT_KEYS_DIR here, or run
#   sudo chown -R 10001:10001 /opt/energy-monitor/keys
BACKEND_UID=10001
BACKEND_GID=10001

# ── MQTT broker ─────────────────────────────────────────────────────────────────
# Folder with server.crt (Let's Encrypt fullchain) and server.key (privkey) for the broker domain
MQTT_CERT_DIR=/opt/energy-monitor/mqtt-certs
# Public domain of the broker, handed to each device when it is linked, e.g. mqtt.example.com
DEVICE_MQTT_PUBLIC_HOST=
DEVICE_MQTT_PUBLIC_PORT=8883
# Backend credentials in the broker. Any random value: openssl rand -hex 24
MQTT_BACKEND_USER=em-backend
MQTT_BACKEND_PASS=

# ── Mail (alerts, password recovery, verification) ─────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Notifications ───────────────────────────────────────────────────────────────
# Public URL of the web app, used by the links in alert mail
NOTIFICATION_WEB_URL=
# Web Push (VAPID). Empty = push disabled, mail still works. Commands in README.md.
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
