// =============================================================================
// Per-device defaults (optional, NEVER committed)
// =============================================================================
// Copy this file to secrets.h (listed in .gitignore) to preload values instead of
// typing them when linking. Whatever is saved on the device (from the web over
// Bluetooth or from the Wi-Fi portal) takes precedence over these defaults.
//
// Without secrets.h the firmware is generic: it boots in setup mode and every
// value is configured when the module is linked from the web.
#pragma once

// Password of the "EnergyMonitor-Setup" access point (at least 8 characters).
// Always set your own: the default in config.h is public.
#define PORTAL_PASSWORD        "choose-a-long-password"

// Identity, only for development. Normally the web app writes it when linking.
// #define DEFAULT_DEVICE_ID      "DEV0000042"     // device.id_device (10 chars)
// #define DEFAULT_DEVICE_CODE    "EM1A2B"         // device.device_code (6), MQTT username
// #define DEFAULT_DEVICE_API_KEY "<api-key>"      // device.api_key, MQTT password

// Broker: production domain (e.g. "mqtt.example.com") or the LAN IP of the PC
// running docker/ in development. Normally the web app writes it when linking.
// #define DEFAULT_MQTT_HOST      "192.168.1.50"
// #define DEFAULT_MQTT_PORT      8883
